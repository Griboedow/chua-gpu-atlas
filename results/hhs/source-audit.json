    "implementation_source": "import json, math, time\nfrom pathlib import Path\nimport numpy as np\nfrom scipy.integrate import solve_ivp\n\nE_REF=3.8626272360560576\nPath('outputs/candidate_research').mkdir(parents=True, exist_ok=True)\ncases=[]\nfor mu in (0.8,1.5):\n    alpha=beta=math.sqrt(mu)\n    for M0,Einit in ((1.05,3.43),(.44,2.71),(.49,4.21)):\n        def rhs(t,z):\n            M,E,D,L0,L=z\n            return [1-4*M+M*M*E,3*M-M*M*E-D*E,\n                    (.1-D-beta*D*(L-1))/1.1,\n                    (1-L0-alpha*(E-E_REF))/1.2,L0-L]\n        def stop(t,z):return 1e8-np.max(np.abs(z))\n        stop.terminal=True;stop.direction=-1\n        initial=[M0,Einit,.1,1,1];start=time.perf_counter()\n        sol=solve_ivp(rhs,(0,1000),initial,method='Radau',rtol=1e-8,atol=1e-10,max_step=.2,dense_output=True,events=stop)\n        late=sol.sol(np.linspace(max(0,sol.t[-1]-25),sol.t[-1],501))\n        all_states=sol.sol(np.linspace(0,sol.t[-1],10001))\n        row={'mu':mu,'alpha':alpha,'beta':beta,'initial_state':initial,'state_order':['M','E','D','L0','L'],'E_reference':E_REF,'E_reference_is_initial_E':False,\n             'success':bool(sol.success),'message':sol.message,'final_time':float(sol.t[-1]),'endpoint':sol.y[:,-1].tolist(),'late_sample_interval':[max(0,float(sol.t[-1])-25),float(sol.t[-1])],\n             'late_min':late.min(axis=1).tolist(),'late_max':late.max(axis=1).tolist(),'late_peak_to_peak':np.ptp(late,axis=1).tolist(),'sampled_full_min':all_states.min(axis=1).tolist(),'sampled_full_max':all_states.max(axis=1).tolist(),\n             'sampled_physical_lengths_positive':bool(np.all(all_states[3:]>0)),'nfev':sol.nfev,'njev':sol.njev,'nlu':sol.nlu,'wall_seconds':time.perf_counter()-start}\n        cases.append(row);print(json.dumps(row),flush=True)\n        Path('outputs/candidate_research/hhs-source-controls.json').write_text(json.dumps({'settings':{'method':'Radau','rtol':1e-8,'atol':1e-10,'max_step':.2,'time_span':[0,1000],'late_samples':501,'full_domain_samples':10001,'state_cutoff':1e8,'fixed_E_reference':E_REF},'cases':cases},indent=2))\n",
